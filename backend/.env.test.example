# Copia este archivo a ".env.test" y ajusta los valores.
#
# Los tests de integración corren contra una base AISLADA de la de
# desarrollo — nunca contra la de .env. Recomendado: una branch de Neon
# dedicada a tests (separada de la de desarrollo), y ADEMÁS un schema de
# Postgres propio dentro de esa branch (parámetro ?schema= en la URL) —
# dos capas de aislamiento, no una. Prisma crea ese schema solo si no existe
# al aplicar las migraciones.
#
# Si tienes Postgres local/Docker, puedes apuntar a una base de datos
# completamente distinta (ej: wm_kestore_test) en vez de una branch de Neon,
# manteniendo igual el parámetro ?schema=.
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/wm_kestore_inventario?schema=test_integration"
DIRECT_URL_TEST="postgresql://postgres:postgres@localhost:5432/wm_kestore_inventario?schema=test_integration"

# Nombre del schema de test, literal. IMPORTANTE: el helper de limpieza
# (tests/helpers.ts) usa este valor tal cual, en vez de preguntarle a Postgres
# cuál es el schema actual — sobre conexiones con pooler (pgbouncer, como en
# Neon) esa pregunta puede responder mal. Si cambias el "schema=" de las URLs
# de arriba, cambia también este valor para que coincidan. NUNCA debe ser
# "public": es justamente la protección contra volver a truncar por error la
# base de desarrollo (ver tests/helpers.ts).
TEST_SCHEMA_NAME="test_integration"

# Duplicados de DATABASE_URL_TEST/DIRECT_URL_TEST, pero con el nombre EXACTO
# que espera Prisma (env("DATABASE_URL") en schema.prisma). Solo los usa el
# script manual "npm run migrate:test" (vía dotenv-cli, que carga este archivo
# tal cual, sin renombrar nada) — para aplicar migraciones a mano contra esta
# base, por ejemplo justo después de crear una branch nueva. El flujo
# automático de `npm test` NO depende de estas dos líneas.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wm_kestore_inventario?schema=test_integration"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/wm_kestore_inventario?schema=test_integration"

JWT_SECRET="test-secret-no-usar-en-produccion"

# Solo necesarias si corrés con NEON_EPHEMERAL_TEST_BRANCH=true (pensado para
# CI): crean y borran una branch de Neon nueva por corrida en vez de usar la
# branch fija de arriba (ver tests/neonEphemeralBranch.ts). En el día a día
# local se dejan vacías y en "false" — no se usan para nada.
NEON_API_KEY=""
NEON_PROJECT_ID=""
NEON_EPHEMERAL_TEST_BRANCH="false"

# Id de la branch fija de arriba (la misma de DATABASE_URL_TEST/DIRECT_URL_TEST).
# Es el padre EXPLÍCITO de toda branch efímera — nunca se deja que Neon elija
# un padre por default, porque el default de un proyecto suele ser
# "production". tests/neonEphemeralBranch.ts verifica esto contra la API
# antes de crear nada, y aborta si TEST_FIXED_BRANCH_ID resulta ser la branch
# marcada como "default" del proyecto.
TEST_FIXED_BRANCH_ID=""
