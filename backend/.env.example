# Copia este archivo a ".env" y ajusta los valores para tu entorno local.

# Cadena de conexión a PostgreSQL (la usa la app en tiempo de ejecución).
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BD?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wm_kestore_inventario?schema=public"

# Conexión directa (sin pgbouncer/pooler), la usa Prisma Migrate.
# Si tu Postgres no usa un pooler (instalación local, Docker), puede ser
# idéntica a DATABASE_URL. Si usas un proveedor con pooler (ej: Neon),
# aquí va la variante "direct"/sin "-pooler" que te da su panel.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/wm_kestore_inventario?schema=public"

# Puerto donde corre la API REST.
PORT=4000

# Secreto para firmar los tokens de sesión (JWT). Cambia este valor en producción.
JWT_SECRET="dev-secret-cambia-esto-en-produccion"
JWT_EXPIRES_IN="8h"

# Orígenes permitidos para CORS, separados por coma (ej:
# "https://app.kestore.com,https://admin.kestore.com"). Opcional en
# desarrollo (sin esta variable, NODE_ENV != "production" cae al modo
# abierto de siempre). OBLIGATORIA en producción: el servidor no arranca sin
# ella si NODE_ENV=production (ver src/lib/checkEnv.ts).
CORS_ORIGIN=""

# Validación de RUC de mayoristas (ApiConsult o EcuadorAPI, aún por definir).
# Sin RUC_VALIDATION_API_URL, el sistema funciona igual: el registro de
# mayoristas simplemente no autocompleta nada y queda para carga manual.
RUC_VALIDATION_API_URL=""
RUC_VALIDATION_API_KEY=""

# --- Correo: recordatorios de pago por vencer al mayorista ---
# SMTP simple via nodemailer. Sin SMTP_HOST y MAIL_FROM el sistema funciona
# igual: el job diario corre pero NO envia nada (y no marca cuentas como
# recordadas, asi que al configurarlo se recuperan). Nunca subas valores reales.
SMTP_HOST=
SMTP_PORT=
# "true" para TLS implicito (puerto 465); vacio = automatico segun el puerto.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Remitente, ej: Kestore Cobranzas <cobranzas@tu-dominio.com>
MAIL_FROM=

# --- Job diario de recordatorios (opcionales; vacio = valor por defecto) ---
# false = no programar el job.
REMINDERS_ENABLED=
# Expresion cron y zona horaria (por defecto "0 8 * * *" en America/Guayaquil).
REMINDER_CRON=
REMINDER_TZ=
# false (por defecto) = UN solo correo por cuenta al entrar a la ventana de 7 dias.
# true = reenviar cada dia mientras siga pendiente y dentro de esa ventana.
REMINDER_REPEAT_DAILY=
# Tope de atraso (en dias completos) para el aviso de "vencida"; vacio = sin tope.
# Las cuentas con MAS dias de atraso que este numero NO reciben ese aviso. Existe
# para que la PRIMERA activacion de SMTP no dispare correos por deudas muy antiguas
# que ya se venian gestionando por otro medio (sin tope, se avisaria a todo
# mayorista con deuda vencida, sin importar hace cuanto). No aplica al aviso "por
# vencer" (0-7 dias). Debe ser un entero >= 0; un valor invalido impide programar
# el job (para no correr sin la proteccion). Ej: 60
REMINDER_OVERDUE_MAX_DAYS=
