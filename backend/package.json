{
  "name": "wm-kestore-inventario-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API de inventario y almacenamiento para WM / Kestore",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "ts-node prisma/seed.ts",
    "reminders:run": "ts-node src/jobs/runDueReminders.ts",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.mts",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "migrate:test": "dotenv -e .env.test -- prisma migrate deploy"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^7.4.4",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "zod": "^3.24.1"
  }
}
